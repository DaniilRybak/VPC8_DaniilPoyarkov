<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="Номенклатура">
		<text>ВЫБРАТЬ
	СпрНоменклатура.Ссылка КАК Услуга,
	Продажи.КоличествоОборот КАК Количество,
	Продажи.СуммаОборот КАК Сумма
ИЗ
	Справочник.Номенклатура КАК СпрНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты КАК Продажи
		ПО СпрНоменклатура.Ссылка = Продажи.Номенклатура
ГДЕ
	СпрНоменклатура.ВидНоменклатуры = &amp;ВидНоменклатуры
УПОРЯДОЧИТЬ 
ПО
	Сумма УБЫВ
</text>
		<textSQL>

		</textSQL>
		<planSQL>

		</planSQL>
		<typeSQL>

		</typeSQL>
		<parameters>
			<parameter name="ВидНоменклатуры" type="EnumRef.ВидНоменклатуры" value="Услуга"/>
		</parameters>
	</query>
	<query name="Номенклатура - Копия 1">
		<text>ВЫБРАТЬ
	СпрНоменклатура.Ссылка КАК Услуга,
	ПродажиОбороты.КоличествоОборот КАК Количество,
	ПродажиОбороты.СуммаОборот КАК Сумма
ИЗ
	РегистрНакопления.Продажи.Обороты КАК ПродажиОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		ПО (ПродажиОбороты.Номенклатура = СпрНоменклатура.Ссылка)     
ГДЕ
	СпрНоменклатура.ВидНоменклатуры = &amp;ВидНоменклатуры
УПОРЯДОЧИТЬ ПО
	Сумма УБЫВ
</text>
		<textSQL>

		</textSQL>
		<planSQL>

		</planSQL>
		<typeSQL>

		</typeSQL>
		<parameters>
			<parameter name="Дата" type="Дата" value="2026-10-20T00:00:00"/>
			<parameter name="Номенклатура" type="CatalogRef.Номенклатура" value="723e6df6-0e53-11f1-9ea2-063dab1e4c3f"/>
			<parameter name="ВидНоменклатуры" type="EnumRef.ВидНоменклатуры" value=""/>
		</parameters>
	</query>
</querylist>